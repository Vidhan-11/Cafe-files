<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#2d1b14">
  <meta name="description" content="Visit Brew Haven Cafe in Dehradun. Find our contact details, opening hours, and directions.">
  <title>Contact & Visit | Brew Haven Cafe</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
  <script src="script.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <nav class="navbar container" aria-label="Main navigation">
      <a class="brand" href="index.html#home" aria-label="Brew Haven Cafe home">
        <span class="brand-mark" aria-hidden="true">B</span>
        <span class="brand-name">Brew Haven<span>C A F E</span></span>
      </a>
      <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="primary-menu">
        <span></span><span></span><span></span>
      </button>
      <div class="nav-links" id="primary-menu">
        <a href="index.html#home">Home</a>
        <a href="menu.html#coffee">Our menu</a>
        <a href="about.html#history">Our story</a>
        <a href="gallery.html#gallery">Gallery</a>
        <a href="index.html#reviews">Reviews</a>
        <a class="nav-cta" href="#contact-details">Contact <span aria-hidden="true">↗</span></a>
      </div>
    </nav>
  </header>

  <main id="main" class="contact-page">
    <section class="contact-page-hero" aria-labelledby="contact-title">
      <div class="container">
        <p class="eyebrow">WE’RE JUST AROUND THE CORNER</p>
        <h1 id="contact-title">Let’s make it<br><em>a coffee date.</em></h1>
        <p>Questions, catch-ups, or just stopping by? We’d love to hear from you.</p>
      </div>
    </section>

    <section class="contact-content" id="contact-details" aria-label="Contact and visit information">
      <div class="container contact-layout">
        <div class="contact-sidebar">
          <section class="contact-panel" aria-labelledby="details-title">
            <p class="eyebrow">COME SAY HELLO</p>
            <h2 id="details-title">Contact details</h2>
            <address class="contact-detail-list">
              <div><span class="contact-icon" aria-hidden="true">⌖</span><p><strong>Find us</strong><a href="https://www.google.com/maps/search/?api=1&amp;query=123+Coffee+Street%2C+Downtown+District%2C+Dehradun" target="_blank" rel="noopener noreferrer">123 Coffee Street, Downtown District, Dehradun</a></p></div>
              <div><span class="contact-icon" aria-hidden="true">☎</span><p><strong>Give us a call</strong><a href="tel:+919876543210">+91 98765 43210</a></p></div>
              <div><span class="contact-icon" aria-hidden="true">✉</span><p><strong>Drop us a line</strong><a href="mailto:hello@brewhavencafe.com">hello@brewhavencafe.com</a></p></div>
            </address>
          </section>

          <section class="contact-panel hours-panel" aria-labelledby="hours-title">
            <p class="eyebrow">YOUR TABLE IS WAITING</p>
            <h2 id="hours-title">Opening hours</h2>
            <dl class="hours-list">
              <div><dt>Monday – Sunday</dt><dd>7:00 AM – 10:00 PM</dd></div>
            </dl>
            <p class="hours-note">Come by any day of the week for a fresh cup and a little pause.</p>
          </section>
        </div>

        <section class="contact-form-panel" aria-labelledby="form-title">
          <p class="eyebrow">SEND A LITTLE NOTE</p>
          <h2 id="form-title">How can we help?</h2>
          <p class="form-intro">Fill in the details below and your email app will open with your message ready to send. If it doesn’t open, email <a href="mailto:hello@brewhavencafe.com">hello@brewhavencafe.com</a>.</p>
          <form class="contact-form" action="mailto:hello@brewhavencafe.com" method="post" enctype="text/plain">
            <div class="form-row">
              <div class="form-field">
                <label for="contact-name">Your name <span aria-hidden="true">*</span></label>
                <input id="contact-name" name="name" type="text" autocomplete="name" required>
              </div>
              <div class="form-field">
                <label for="contact-email">Email address <span aria-hidden="true">*</span></label>
                <input id="contact-email" name="email" type="email" autocomplete="email" required>
              </div>
            </div>
            <div class="form-field">
              <label for="contact-phone">Phone number <span class="optional-label">(optional)</span></label>
              <input id="contact-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel">
            </div>
            <div class="form-field">
              <label for="contact-message">Your message <span aria-hidden="true">*</span></label>
              <textarea id="contact-message" name="message" rows="5" required></textarea>
            </div>
            <button class="button button-primary contact-submit" type="submit">Send your message <span aria-hidden="true">→</span></button>
          </form>
        </section>
      </div>
    </section>

    <section class="map-section" aria-labelledby="map-title">
      <div class="container">
        <div class="map-heading">
          <div><p class="eyebrow">YOUR NEXT COFFEE STOP</p><h2 id="map-title">Find your way <em>to us.</em></h2></div>
          <a class="text-link" href="https://www.google.com/maps/search/?api=1&amp;query=123+Coffee+Street%2C+Downtown+District%2C+Dehradun" target="_blank" rel="noopener noreferrer">Open Google Maps <span aria-hidden="true">↗</span></a>
        </div>
        <div class="map-placeholder" role="img" aria-label="Map placeholder for Brew Haven Cafe, 123 Coffee Street, Downtown District, Dehradun">
          <span class="map-pin" aria-hidden="true">⌖</span>
          <strong>Brew Haven Cafe</strong>
          <span>123 Coffee Street, Downtown District, Dehradun</span>
          <span class="map-placeholder-note">Map preview placeholder</span>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-main">
      <a class="brand footer-brand" href="index.html#home" aria-label="Brew Haven Cafe home">
        <span class="brand-mark" aria-hidden="true">B</span>
        <span class="brand-name">Brew Haven<span>C A F E</span></span>
      </a>
      <p class="footer-tagline">Crafted coffee.<br><em>Inspired moments.</em></p>
      <div class="footer-contact"><span>COME SAY HELLO</span><a href="mailto:hello@brewhavencafe.com">hello@brewhavencafe.com</a><a href="tel:+919876543210">+91 98765 43210</a></div>
      <div class="footer-social"><span>FOLLOW ALONG</span><a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer">Instagram ↗</a></div>
    </div>
    <div class="container footer-bottom"><span>© <span id="current-year">2026</span> Brew Haven Cafe. Made with care.</span><a href="#main">Back to the top ↑</a></div>
  </footer>
</body>
</html>
