          <article class="coffee-card">
            <div class="coffee-image image-macchiato" role="img" aria-label="Caramel macchiato topped with delicate latte art"><span class="card-tag">A LITTLE SWEET</span><span class="coffee-number">02</span></div>
            <div class="coffee-info"><div><h3>Caramel Macchiato</h3><p>Silky espresso, milk, caramel.</p></div><span class="price">₹260</span></div>
          </article>
          <article class="coffee-card">
            <div class="coffee-image image-coldbrew" role="img" aria-label="A glass of cold brew coffee with ice"><span class="card-tag">SLOW STEEPED</span><span class="coffee-number">03</span></div>
            <div class="coffee-info"><div><h3>Cold Brew Reserve</h3><p>18 hours for a smoother kind of bold.</p></div><span class="price">₹240</span></div>
