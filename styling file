:root {
  color-scheme: dark;
  --coffee-dark: #3E2723;
  --coffee: #5D4037;
  --coffee-light: #795548;
  --cream: #D7CCC8;
  --amber: #FFB74D;
  --surface: #49332d;
  --surface-raised: #523a32;
  --text: #f7f0ec;
  --muted: #c5b6b0;
  --serif: "Playfair Display", Georgia, serif;
  --sans: "DM Sans", Arial, sans-serif;
}

* { box-sizing: border-box; }

html {
  scroll-behavior: smooth;
  scroll-padding-top: 84px;
}

body {
  margin: 0;
  color: var(--text);
  background: var(--coffee-dark);
  font-family: var(--sans);
  font-size: 15px;
  line-height: 1.65;
}

img { display: block; max-width: 100%; }
a { color: inherit; text-decoration: none; }
button { font: inherit; }

.container {
  width: min(1120px, calc(100% - 64px));
  margin-inline: auto;
}

.skip-link {
  position: absolute;
  z-index: 20;
  top: 8px;
  left: 8px;
  padding: 10px 14px;
  color: var(--coffee-dark);
  background: var(--amber);
  transform: translateY(-150%);
}

.skip-link:focus { transform: translateY(0); }

/* Navigation */
.site-header {
  position: absolute;
  z-index: 10;
  inset: 0 0 auto;
  color: var(--text);
}

.navbar {
  min-height: 88px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgb(215 204 200 / 22%);
}

.brand { display: inline-flex; gap: 11px; align-items: center; }

.brand-mark {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border: 1px solid var(--amber);
  border-radius: 50%;
  color: var(--amber);
  font-family: var(--serif);
  font-size: 23px;
  font-style: italic;
}

.brand-name {
  display: flex;
  flex-direction: column;
  font-family: var(--serif);
  font-size: 18px;
  font-weight: 600;
  line-height: 1.1;
}

.brand-name span {
  margin-top: 5px;
  font-family: var(--sans);
  font-size: 8px;
  letter-spacing: 3px;
}

.nav-links {
  display: flex;
  gap: 20px;
  align-items: center;
  font-size: 12px;
  font-weight: 500;
}

.nav-links > a:not(.nav-cta) {
  color: rgb(247 240 236 / 82%);
  transition: color .2s ease;
}

.nav-links > a:not(.nav-cta):hover,
.nav-links > a:focus-visible { color: var(--amber); }

.nav-cta {
  padding: 10px 16px;
  border: 1px solid rgb(215 204 200 / 65%);
  border-radius: 3px;
}

.nav-cta span { margin-left: 8px; color: var(--amber); }
.menu-toggle { display: none; }

/* Hero */
.hero {
  position: relative;
  min-height: min(790px, 100svh);
  display: flex;
  align-items: center;
  overflow: hidden;
  color: var(--text);
  background: var(--coffee-dark) url("https://images.unsplash.com/photo-1442512595331-e89e73853f31?auto=format&fit=crop&w=2200&q=85") center 48% / cover no-repeat;
}

.hero-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgb(36 20 17 / 91%), rgb(62 39 35 / 68%) 48%, rgb(35 22 19 / 28%)), linear-gradient(0deg, rgb(36 20 17 / 34%), transparent 48%);
}

.hero-content { position: relative; z-index: 1; padding-top: 72px; }

.eyebrow {
  margin: 0 0 20px;
  color: var(--amber);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2.2px;
}

.hero-eyebrow { display: flex; align-items: center; gap: 10px; }
.hero-eyebrow span { width: 22px; height: 1px; background: var(--amber); }
.hero h1, h2, h3, p { margin-top: 0; }

.hero h1 {
  margin-bottom: 21px;
  font-family: var(--serif);
  font-size: clamp(52px, 7.3vw, 91px);
  font-weight: 500;
  letter-spacing: -2.7px;
  line-height: 1.05;
}

.hero h1 em, h2 em { color: var(--amber); font-weight: 500; }
.hero-copy { max-width: 425px; margin-bottom: 30px; color: rgb(247 240 236 / 78%); font-size: 15px; line-height: 1.8; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 13px; align-items: center; }

/* Buttons */
.button {
  min-height: 48px;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 18px;
  padding: 0 21px;
  border: 1px solid transparent;
  border-radius: 3px;
  font-size: 12px;
  font-weight: 700;
  transition: transform .2s ease, background .2s ease, color .2s ease;
}

.button:hover { transform: translateY(-2px); }
.button-primary { color: var(--coffee-dark); background: var(--amber); }
.button-primary:hover { background: #ffc870; }
.button-quiet { color: var(--text); }
.play-icon { width: 25px; height: 25px; display: grid; place-items: center; border: 1px solid rgb(247 240 236 / 70%); border-radius: 50%; font-size: 8px; }
.hero-note { display: flex; gap: 12px; align-items: center; margin-top: 55px; color: rgb(247 240 236 / 73%); font-size: 11px; }
.note-stars, .review-stars { color: var(--amber); letter-spacing: 3px; }
.scroll-cue { position: absolute; right: max(32px, calc((100% - 1120px) / 2)); bottom: 34px; display: flex; align-items: center; gap: 12px; color: rgb(247 240 236 / 75%); font-size: 8px; letter-spacing: 1.8px; writing-mode: vertical-rl; }
.scroll-cue span { width: 1px; height: 38px; background: var(--amber); }

/* Feature strip */
.perks { padding: 27px 0; background: var(--coffee); }
.perks-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
.perk { display: flex; align-items: center; justify-content: center; gap: 12px; color: var(--cream); font-size: 11px; line-height: 1.55; }
.perk + .perk { border-left: 1px solid rgb(215 204 200 / 20%); }
.perk strong { color: var(--text); font-size: 12px; }
.perk-icon { color: var(--amber); font-size: 23px; }

/* Featured cards */
.section { padding: 104px 0; }
.menu-section, .reviews-section { background: var(--coffee-dark); }
.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 35px; margin-bottom: 43px; }
.section-heading .eyebrow, .about-content .eyebrow, .reviews-heading .eyebrow, .visit-section .eyebrow { margin-bottom: 14px; }

h2 {
  margin-bottom: 0;
  font-family: var(--serif);
  font-size: clamp(37px, 4.3vw, 55px);
  font-weight: 500;
  letter-spacing: -1.3px;
  line-height: 1.15;
}

.section-intro { max-width: 340px; margin-bottom: 6px; color: var(--cream); font-size: 13px; line-height: 1.8; opacity: .78; }
.coffee-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 23px; }
.coffee-card { min-width: 0; padding: 11px; background: var(--surface); }

.coffee-image {
  position: relative;
  height: 270px;
  overflow: hidden;
  background-color: var(--coffee-light);
  background-position: center;
  background-size: cover;
}

.coffee-image::after { position: absolute; inset: 0; content: ""; background: linear-gradient(0deg, rgb(36 20 17 / 48%), transparent 45%); }
.image-espresso { background-image: url("https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?auto=format&fit=crop&w=900&q=80"); }
.image-macchiato { background-image: url("https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=900&q=80"); }
.image-coldbrew { background-image: url("https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=900&q=80"); }
.card-tag, .coffee-number { position: absolute; z-index: 1; color: var(--text); }
.card-tag { top: 16px; left: 16px; padding: 6px 9px; background: rgb(62 39 35 / 88%); font-size: 8px; font-weight: 600; letter-spacing: 1.5px; }
.coffee-number { right: 16px; bottom: 10px; font-family: var(--serif); font-size: 30px; font-style: italic; opacity: .85; }
.coffee-info { display: flex; justify-content: space-between; gap: 10px; padding: 15px 7px 7px; }
.coffee-info h3 { margin-bottom: 4px; font-family: var(--serif); font-size: 19px; font-weight: 600; }
.coffee-info p { margin: 0; color: var(--cream); font-size: 11px; opacity: .75; }
.price { padding-top: 2px; color: var(--amber); font-size: 13px; font-weight: 700; white-space: nowrap; }
.menu-bottom { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-top: 38px; padding-top: 19px; border-top: 1px solid rgb(215 204 200 / 20%); }
.menu-bottom p { margin: 0; color: var(--cream); font-size: 11px; opacity: .75; }
.text-link { display: inline-flex; gap: 15px; align-items: center; color: var(--amber); font-size: 11px; font-weight: 700; }
.text-link span { font-size: 16px; transition: transform .2s ease; }
.text-link:hover span { transform: translateX(4px); }

/* About */
.about-section { display: grid; grid-template-columns: 1fr 1fr; min-height: 600px; background: var(--coffee); }
.about-image { min-height: 500px; background: var(--coffee-light) url("https://images.unsplash.com/photo-1445116572660-236099ec97a0?auto=format&fit=crop&w=1300&q=85") center / cover no-repeat; }
.about-content { align-self: center; max-width: 570px; padding: 75px clamp(40px, 8vw, 115px); }
.about-content h2 { margin-bottom: 23px; }
.about-content > p:not(.eyebrow) { margin-bottom: 13px; color: var(--cream); font-size: 12px; line-height: 1.9; opacity: .85; }
.about-content .text-link { margin-top: 8px; }
.about-stats { display: flex; gap: 35px; margin-top: 38px; padding-top: 23px; border-top: 1px solid rgb(215 204 200 / 25%); }
.about-stats div { display: flex; flex-direction: column; }
.about-stats strong { font-family: var(--serif); font-size: 26px; font-weight: 500; line-height: 1.2; }
.about-stats strong span { color: var(--amber); font-family: var(--sans); font-size: 16px; }
.about-stats small { margin-top: 5px; color: var(--cream); font-size: 9px; }

/* Testimonials */
.reviews-heading { margin-bottom: 43px; text-align: center; }
.reviews-heading h2 { font-size: clamp(35px, 4vw, 49px); }
.reviews-heading h2 em { color: var(--amber); }
.reviews-heading > p:last-child { margin: 13px 0 0; color: var(--cream); font-size: 12px; opacity: .8; }
.review-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
.review-card { position: relative; min-height: 220px; margin: 0; padding: 25px 24px 20px; border: 1px solid rgb(215 204 200 / 18%); background: var(--surface); }
.review-featured { background: var(--coffee); border-color: var(--coffee); }
.review-stars { font-size: 12px; }
.review-card blockquote { min-height: 75px; margin: 15px 0 17px; color: var(--text); font-family: var(--serif); font-size: 16px; line-height: 1.55; }
.review-card figcaption { display: flex; align-items: center; gap: 10px; }
.avatar { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; color: var(--coffee-dark); background: var(--amber); font-family: var(--serif); font-size: 15px; }
.avatar-two { background: var(--cream); }.avatar-three { background: #bc8e70; }
.review-card figcaption strong, .review-card figcaption small { display: block; }
.review-card figcaption strong { font-size: 10px; }
.review-card figcaption small { margin-top: 1px; color: var(--cream); font-size: 9px; opacity: .75; }
.quote-mark { margin-left: auto; color: rgb(215 204 200 / 48%); font-family: var(--serif); font-size: 42px; line-height: 1; }

/* Visit and footer */
.visit-section { padding: 48px 0; color: var(--text); background: #2b1d1a; }
.visit-inner { display: flex; justify-content: space-between; align-items: center; gap: 28px; }
.visit-section .eyebrow { font-size: 9px; }
.visit-section h2 { font-size: 43px; }
.visit-details p { display: flex; gap: 11px; align-items: center; margin: 5px 0; color: var(--cream); font-size: 11px; }
.visit-details p span { color: var(--amber); font-size: 16px; }
.button-light { color: var(--coffee-dark); background: var(--cream); white-space: nowrap; }
.button-light:hover { background: #fff; }

.contact-panel, .contact-form-panel { color: var(--coffee-dark); }
.contact-content .eyebrow, .map-section .eyebrow { color: #8c5729; }
.map-section { color: var(--coffee-dark); }
.map-heading .text-link { color: #8c5729; }

.site-footer { color: var(--text); background: #211613; }
.footer-main { display: grid; grid-template-columns: 1.1fr 1fr 1.2fr .8fr; gap: 35px; align-items: start; padding-top: 45px; padding-bottom: 39px; }
.footer-brand { align-self: start; }
.footer-tagline { margin: 0; color: var(--cream); font-family: var(--serif); font-size: 17px; line-height: 1.55; }
.footer-tagline em { color: var(--amber); }
.footer-contact, .footer-social { display: flex; flex-direction: column; gap: 7px; font-size: 10px; }
.footer-contact > span, .footer-social > span { margin-bottom: 4px; color: var(--amber); font-size: 8px; font-weight: 700; letter-spacing: 1.7px; }
.footer-contact a, .footer-social a { color: var(--cream); }
.footer-contact a:hover, .footer-social a:hover { color: var(--amber); }
.footer-bottom { display: flex; justify-content: space-between; gap: 15px; padding-top: 15px; padding-bottom: 15px; border-top: 1px solid rgb(215 204 200 / 18%); color: var(--cream); font-size: 9px; }
.footer-bottom a { color: var(--text); }

:focus-visible { outline: 2px solid var(--amber); outline-offset: 4px; }

@media (max-width: 800px) {
  .container { width: min(100% - 44px, 650px); }
  .navbar { min-height: 76px; }
  .menu-toggle { width: 42px; height: 42px; display: flex; flex-direction: column; justify-content: center; gap: 5px; align-items: center; border: 1px solid rgb(215 204 200 / 48%); border-radius: 3px; color: var(--text); background: transparent; cursor: pointer; }
  .menu-toggle span { width: 17px; height: 1px; display: block; background: currentColor; transition: transform .2s ease, opacity .2s ease; }
  .menu-toggle[aria-expanded="true"] span:first-child { transform: translateY(6px) rotate(45deg); }
  .menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded="true"] span:last-child { transform: translateY(-6px) rotate(-45deg); }
  .nav-links { position: absolute; top: 76px; right: 22px; left: 22px; display: none; flex-direction: column; align-items: stretch; gap: 0; padding: 8px 18px; border: 1px solid rgb(215 204 200 / 15%); background: var(--coffee-dark); box-shadow: 0 16px 30px rgb(0 0 0 / 28%); }
  .nav-links.is-open { display: flex; }
  .nav-links > a:not(.nav-cta) { padding: 13px 0; border-bottom: 1px solid rgb(215 204 200 / 15%); }
  .nav-cta { margin: 12px 0 5px; text-align: center; }
  .hero { min-height: min(750px, 100svh); background-position: 57% center; }
  .hero-shade { background: linear-gradient(90deg, rgb(36 20 17 / 87%), rgb(62 39 35 / 58%)), linear-gradient(0deg, rgb(36 20 17 / 25%), transparent 50%); }
  .hero-content { padding-top: 70px; }
  .perks-grid { grid-template-columns: repeat(2, 1fr); row-gap: 22px; }
  .perk:nth-child(3) { border-left: 0; }
  .section { padding: 78px 0; }
  .coffee-image { height: 220px; }
  .about-section { grid-template-columns: 1fr 1fr; }
  .about-content { padding: 48px 30px; }
  .about-stats { gap: 21px; }
  .visit-inner { flex-wrap: wrap; }
  .visit-inner > div:first-child { width: 100%; }
  .footer-main { grid-template-columns: 1fr 1fr; row-gap: 28px; }
}

@media (max-width: 560px) {
  body { font-size: 14px; }
  .container { width: calc(100% - 40px); }
  .hero { min-height: min(740px, 100svh); background-position: 61% center; }
  .hero h1 { font-size: clamp(51px, 14vw, 70px); letter-spacing: -1.8px; }
  .hero-copy { max-width: 340px; font-size: 13px; }
  .hero-note { margin-top: 42px; font-size: 9px; }
  .scroll-cue { right: 15px; bottom: 24px; }
  .perks { padding: 22px 0; }
  .perk { justify-content: flex-start; gap: 8px; font-size: 9px; }
  .perk strong { font-size: 10px; }
  .perk-icon { font-size: 19px; }
  .section { padding: 68px 0; }
  .section-heading { display: block; margin-bottom: 30px; }
  .section-intro { margin-top: 16px; font-size: 12px; }
  h2 { font-size: 39px; }
  .coffee-grid { grid-template-columns: 1fr; gap: 20px; }
  .coffee-card { padding: 9px; }
  .coffee-image { height: 260px; }
  .coffee-info h3 { font-size: 20px; }
  .menu-bottom { align-items: flex-start; flex-direction: column; gap: 10px; }
  .about-section { grid-template-columns: 1fr; }
  .about-image { min-height: 320px; }
  .about-content { max-width: none; padding: 54px 25px 57px; }
  .about-content h2 { font-size: 43px; }
  .about-stats { justify-content: space-between; gap: 12px; }
  .reviews-heading { margin-bottom: 30px; }
  .review-grid { grid-template-columns: 1fr; gap: 12px; }
  .review-card { min-height: auto; padding: 22px; }
  .review-card blockquote { min-height: auto; }
  .visit-section { padding: 40px 0; }
  .visit-inner { align-items: flex-start; flex-direction: column; gap: 17px; }
  .visit-inner > div:first-child { width: auto; }
  .visit-section h2 { font-size: 39px; }
  .visit-details p { align-items: flex-start; font-size: 10px; }
  .footer-main { grid-template-columns: 1fr 1fr; column-gap: 15px; padding-top: 35px; }
  .footer-tagline { font-size: 14px; }
  .footer-contact { overflow-wrap: anywhere; }
  .footer-bottom { font-size: 8px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
}

/* Menu page */
.menu-page { background: var(--coffee-dark); }
.menu-page-hero { padding: 165px 0 52px; border-bottom: 1px solid rgb(215 204 200 / 16%); background: linear-gradient(135deg, var(--coffee-dark), #4a3029); }
.menu-page-hero h1 { margin: 0 0 13px; font-family: var(--serif); font-size: clamp(42px, 6vw, 68px); font-weight: 500; letter-spacing: -1.8px; line-height: 1.12; }
.menu-page-hero h1 em { color: var(--amber); font-weight: 500; }
.menu-page-hero .container > p:not(.eyebrow) { max-width: 500px; margin-bottom: 27px; color: var(--cream); font-size: 13px; }
.menu-shortcuts { display: flex; flex-wrap: wrap; gap: 10px; }
.menu-shortcuts a { display: inline-flex; gap: 12px; align-items: center; padding: 9px 13px; border: 1px solid rgb(215 204 200 / 25%); border-radius: 2px; color: var(--cream); font-size: 10px; transition: border-color .2s ease, color .2s ease; }
.menu-shortcuts a span { color: var(--amber); }
.menu-shortcuts a:hover { border-color: var(--amber); color: var(--amber); }
.menu-page-content { padding-top: 20px; padding-bottom: 45px; }
.menu-category { padding: 56px 0; scroll-margin-top: 24px; }
.menu-category + .menu-category { border-top: 1px solid rgb(215 204 200 / 18%); }
.menu-category-heading { display: grid; grid-template-columns: 52px 1fr minmax(190px, 300px); gap: 20px; align-items: center; margin-bottom: 26px; }
.menu-category-number { align-self: start; padding-top: 4px; color: var(--amber); font-family: var(--serif); font-size: 23px; font-style: italic; }
.menu-category-heading .eyebrow { margin-bottom: 6px; font-size: 9px; }
.menu-category-heading h2 { font-size: 37px; }
.menu-category-heading > p { margin: 0; color: var(--cream); font-size: 11px; line-height: 1.7; opacity: .8; }
.menu-items { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 28px; }
.menu-item { min-width: 0; display: flex; justify-content: space-between; gap: 15px; padding: 17px 0; border-top: 1px solid rgb(215 204 200 / 14%); }
.menu-item h3 { margin-bottom: 5px; font-family: var(--serif); font-size: 17px; font-weight: 600; }
.menu-item p { max-width: 390px; margin: 0; color: var(--cream); font-size: 10px; line-height: 1.65; opacity: .76; }
.menu-price { padding-top: 2px; color: var(--amber); font-size: 12px; font-weight: 700; white-space: nowrap; }
.menu-page-cta { padding: 40px 0; background: var(--coffee); }
.menu-page-cta-inner { display: flex; justify-content: space-between; align-items: center; gap: 24px; }
.menu-page-cta .eyebrow { margin-bottom: 8px; }
.menu-page-cta h2 { font-size: 34px; }

@media (max-width: 800px) {
  .menu-category-heading { grid-template-columns: 38px 1fr; gap: 15px; }
  .menu-category-heading > p { grid-column: 2; max-width: 420px; }
  .menu-items { gap: 0 20px; }
}

@media (max-width: 560px) {
  .menu-page-hero { padding: 140px 0 36px; }
  .menu-page-hero h1 { font-size: 45px; }
  .menu-shortcuts { gap: 8px; }
  .menu-shortcuts a { padding: 8px 10px; font-size: 9px; }
  .menu-category { padding: 40px 0; }
  .menu-category-heading { grid-template-columns: 27px 1fr; gap: 11px; margin-bottom: 18px; }
  .menu-category-heading h2 { font-size: 32px; }
  .menu-category-number { font-size: 19px; }
  .menu-items { grid-template-columns: 1fr; }
  .menu-item { padding: 14px 0; }
  .menu-page-cta-inner { align-items: flex-start; flex-direction: column; }
  .menu-page-cta h2 { font-size: 30px; }
}

/* About page */
.about-page { background: var(--coffee-dark); }
.about-page-hero { padding: 155px 0 48px; background: linear-gradient(135deg, var(--coffee-dark), #4a3029); }
.about-page-hero h1 { margin: 0 0 17px; font-family: var(--serif); font-size: clamp(48px, 7vw, 78px); font-weight: 500; letter-spacing: -2px; line-height: 1.08; }
.about-page-hero h1 em { color: var(--amber); font-weight: 500; }
.about-page-hero .container > p:not(.eyebrow) { max-width: 520px; margin-bottom: 27px; color: var(--cream); font-size: 13px; line-height: 1.8; }
.about-history { padding: 86px 0; }
.about-history-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(35px, 7vw, 90px); align-items: center; }
.about-history-image { position: relative; min-height: 470px; background: var(--coffee); }
.about-history-image img { width: 100%; height: 100%; min-height: 470px; object-fit: cover; }
.history-image-note { position: absolute; right: 0; bottom: 0; padding: 11px 15px; color: var(--coffee-dark); background: var(--amber); font-size: 9px; font-weight: 700; letter-spacing: .5px; }
.about-history-copy h2 { margin-bottom: 20px; font-size: clamp(36px, 4vw, 48px); }
.about-history-copy h2 em { color: var(--amber); }
.about-history-copy > p:not(.eyebrow) { color: var(--cream); font-size: 12px; line-height: 1.85; opacity: .84; }
.about-history-copy .history-lead { color: var(--text) !important; font-family: var(--serif); font-size: 17px !important; line-height: 1.65 !important; opacity: 1 !important; }
.about-history-copy .text-link { margin-top: 6px; }
.history-mark { display: flex; gap: 14px; align-items: center; margin-top: 30px; padding-top: 18px; border-top: 1px solid rgb(215 204 200 / 18%); }
.history-mark span:first-child { color: var(--amber); font-family: var(--serif); font-size: 22px; }
.history-mark span:last-child { color: var(--cream); font-size: 10px; }
.about-values { padding: 76px 0; background: var(--coffee); }
.about-values-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
.about-value-card { min-height: 270px; padding: 31px; border: 1px solid rgb(215 204 200 / 18%); background: rgb(62 39 35 / 48%); }
.about-value-card .value-icon { display: inline-grid; width: 38px; height: 38px; margin-bottom: 21px; place-items: center; border: 1px solid rgb(255 183 77 / 55%); border-radius: 50%; color: var(--amber); font-size: 18px; }
.about-value-card .eyebrow { margin-bottom: 8px; font-size: 9px; }
.about-value-card h2 { margin-bottom: 12px; font-size: 34px; }
.about-value-card h2 em { color: var(--amber); }
.about-value-card > p:last-child { max-width: 430px; margin: 0; color: var(--cream); font-size: 12px; line-height: 1.8; opacity: .83; }
.vision-card { background: rgb(43 29 26 / 60%); }
.about-team { padding: 92px 0; }
.team-heading { display: flex; justify-content: space-between; align-items: end; gap: 35px; margin-bottom: 37px; }
.team-heading .eyebrow { margin-bottom: 12px; }
.team-heading h2 { max-width: 550px; font-size: clamp(36px, 4vw, 48px); }
.team-heading h2 em { color: var(--amber); }
.team-heading > p { max-width: 330px; margin: 0 0 5px; color: var(--cream); font-size: 12px; line-height: 1.8; opacity: .8; }
.team-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
.team-card { min-width: 0; overflow: hidden; background: var(--surface); }
.team-card > img { width: 100%; height: 230px; object-fit: cover; transition: transform .45s ease; }
.team-card:hover > img { transform: scale(1.035); }
.team-card-copy { padding: 20px 21px 23px; }
.team-card-copy > span { color: var(--amber); font-size: 8px; font-weight: 700; letter-spacing: 1.6px; }
.team-card-copy h3 { margin: 7px 0 8px; font-family: var(--serif); font-size: 21px; font-weight: 600; }
.team-card-copy p { margin: 0; color: var(--cream); font-size: 10px; line-height: 1.75; opacity: .8; }

@media (max-width: 800px) {
  .about-history { padding: 65px 0; }
  .about-history-grid { gap: 28px; }
  .about-history-image, .about-history-image img { min-height: 390px; }
  .about-history-copy h2 { font-size: 36px; }
  .team-heading { align-items: flex-start; flex-direction: column; gap: 15px; }
}

@media (max-width: 560px) {
  .about-page-hero { padding: 138px 0 36px; }
  .about-page-hero h1 { font-size: 48px; }
  .about-history { padding: 50px 0; }
  .about-history-grid { grid-template-columns: 1fr; gap: 27px; }
  .about-history-image, .about-history-image img { min-height: 300px; }
  .about-history-copy h2 { font-size: 38px; }
  .about-values { padding: 52px 0; }
  .about-values-grid { grid-template-columns: 1fr; gap: 12px; }
  .about-value-card { min-height: 0; padding: 25px; }
  .about-team { padding: 62px 0; }
  .team-heading { margin-bottom: 25px; }
  .team-heading h2 { font-size: 37px; }
  .team-grid { grid-template-columns: 1fr; gap: 14px; }
  .team-card > img { height: 240px; }
}

/* Gallery page */
.gallery-page-hero { padding: 155px 0 48px; background: linear-gradient(135deg, var(--coffee-dark), #4a3029); }
.gallery-page-hero h1 { margin: 0 0 15px; font-family: var(--serif); font-size: clamp(48px, 7vw, 76px); font-weight: 500; letter-spacing: -1.8px; line-height: 1.08; }
.gallery-page-hero h1 em { color: var(--amber); font-weight: 500; }
.gallery-page-hero .container > p:not(.eyebrow) { max-width: 510px; margin: 0; color: var(--cream); font-size: 13px; line-height: 1.8; }
.gallery-section { padding: 88px 0; scroll-margin-top: 20px; background: var(--coffee); }
.gallery-heading { margin-bottom: 35px; }
.gallery-heading h2 em { color: var(--amber); }
.gallery-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 190px; gap: 14px; }
.gallery-item { position: relative; min-height: 0; margin: 0; overflow: hidden; background: var(--coffee-light); }
.gallery-item:first-child { grid-row: span 2; }
.gallery-item:nth-child(4n) { grid-column: span 2; }
.gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease, filter .45s ease; }
.gallery-item:hover img { transform: scale(1.05); filter: brightness(.82); }
.gallery-item::after { position: absolute; inset: 40% 0 0; content: ""; pointer-events: none; background: linear-gradient(transparent, rgb(36 20 17 / 70%)); }
.gallery-item figcaption { position: absolute; z-index: 1; right: 15px; bottom: 12px; left: 15px; color: var(--text); font-size: 11px; }

@media (max-width: 800px) {
  .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 170px; }
  .gallery-item:nth-child(4n) { grid-column: auto; }
}

@media (max-width: 560px) {
  .gallery-page-hero { padding: 138px 0 36px; }
  .gallery-page-hero h1 { font-size: 48px; }
  .gallery-section { padding: 60px 0; }
  .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 135px; gap: 9px; }
  .gallery-item:nth-child(4n) { grid-column: auto; }
}

/* Contact page */
.contact-page { --espresso: var(--coffee-dark); --mocha: var(--coffee); --paper: #faf6f0; --muted: #82766b; }
.contact-page-hero { padding: 155px 0 48px; background: linear-gradient(135deg, var(--espresso), var(--mocha)); color: #fff; }
.contact-page-hero h1 { margin: 0 0 15px; font-family: var(--serif); font-size: clamp(48px, 7vw, 76px); font-weight: 500; letter-spacing: -1.8px; line-height: 1.08; }
.contact-page-hero h1 em { color: var(--amber); font-weight: 500; }
.contact-page-hero .container > p:not(.eyebrow) { max-width: 480px; margin: 0; color: rgb(255 255 255 / 78%); font-size: 13px; line-height: 1.8; }
.contact-content { padding: 75px 0; background: var(--paper); }
.contact-layout { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 25px; align-items: start; }
.contact-sidebar { display: grid; gap: 18px; }
.contact-panel, .contact-form-panel { padding: 27px; border: 1px solid #e8dfd4; background: #fff; }
.contact-panel .eyebrow, .contact-form-panel .eyebrow { margin-bottom: 9px; }
.contact-panel h2, .contact-form-panel h2 { margin-bottom: 20px; font-size: 30px; }
.contact-detail-list { display: grid; gap: 19px; margin: 0; font-style: normal; }
.contact-detail-list > div { display: flex; gap: 12px; align-items: flex-start; }
.contact-icon { width: 32px; height: 32px; flex: 0 0 32px; display: grid; place-items: center; border-radius: 50%; color: #8c5729; background: #f5ebdd; font-size: 15px; }
.contact-detail-list p { min-width: 0; margin: 0; }
.contact-detail-list strong, .contact-detail-list a { display: block; }
.contact-detail-list strong { margin-bottom: 3px; font-size: 11px; }
.contact-detail-list a { color: var(--muted); font-size: 11px; overflow-wrap: anywhere; }
.contact-detail-list a:hover { color: #8c5729; }
.hours-panel h2 { margin-bottom: 13px; }
.hours-list { margin: 0; }
.hours-list > div { display: flex; justify-content: space-between; gap: 12px; padding: 11px 0; border-top: 1px solid #eee6dc; font-size: 11px; }
.hours-list dt { color: var(--espresso); font-weight: 600; }
.hours-list dd { margin: 0; color: #8c5729; text-align: right; }
.hours-note { margin: 10px 0 0; color: var(--muted); font-size: 10px; }
.contact-form-panel { padding: 31px; }
.contact-form-panel h2 { margin-bottom: 8px; }
.form-intro { margin-bottom: 22px; color: var(--muted); font-size: 11px; }
.form-intro a { color: #8c5729; text-decoration: underline; }
.contact-form { display: grid; gap: 16px; }
.form-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
.form-field { min-width: 0; display: grid; gap: 6px; }
.form-field label { color: var(--espresso); font-size: 10px; font-weight: 700; }
.form-field label > span:not(.optional-label) { color: #b76124; }
.optional-label { color: var(--muted); font-weight: 400; }
.form-field input, .form-field textarea { width: 100%; min-height: 43px; padding: 10px 12px; border: 1px solid #ded5cb; border-radius: 2px; color: var(--espresso); background: var(--paper); font: inherit; font-size: 12px; }
.form-field textarea { min-height: 125px; resize: vertical; }
.form-field input:focus, .form-field textarea:focus { border-color: #a76f3b; outline: 2px solid rgb(167 111 59 / 18%); }
.form-field [aria-invalid="true"] { border-color: #b54032; }
.contact-submit { justify-self: start; border: 0; cursor: pointer; }
.map-section { padding: 70px 0 85px; background: #f1e8de; }
.map-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 23px; }
.map-heading .eyebrow { margin-bottom: 8px; }
.map-heading h2 { font-size: 38px; }
.map-heading h2 em { color: #a76f3b; }
.map-placeholder { min-height: 290px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 8px; padding: 25px; border: 1px solid #ded1c3; color: var(--espresso); background-color: #e4d7c8; background-image: linear-gradient(35deg, transparent 48%, rgb(255 255 255 / 45%) 49%, rgb(255 255 255 / 45%) 51%, transparent 52%), linear-gradient(145deg, transparent 48%, rgb(255 255 255 / 40%) 49%, rgb(255 255 255 / 40%) 51%, transparent 52%); background-size: 74px 74px, 103px 103px; text-align: center; }
.map-pin { width: 42px; height: 42px; display: grid; place-items: center; margin-bottom: 5px; border-radius: 50%; color: white; background: #8d4e35; font-size: 22px; }
.map-placeholder strong { font-family: var(--serif); font-size: 22px; }
.map-placeholder > span:not(.map-pin) { color: #65564c; font-size: 11px; }
.map-placeholder .map-placeholder-note { margin-top: 5px; color: #82766b; font-size: 9px; letter-spacing: .5px; }

@media (max-width: 800px) {
  .contact-layout { grid-template-columns: 1fr; }
  .contact-sidebar { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; }
}

@media (max-width: 560px) {
  .contact-page-hero { padding: 138px 0 36px; }
  .contact-page-hero h1 { font-size: 48px; }
  .contact-content { padding: 48px 0; }
  .contact-sidebar { grid-template-columns: 1fr; }
  .contact-panel, .contact-form-panel { padding: 23px 19px; }
  .form-row { grid-template-columns: 1fr; }
  .map-section { padding: 52px 0 62px; }
  .map-heading { align-items: flex-start; flex-direction: column; }
  .map-heading h2 { font-size: 34px; }
  .map-placeholder { min-height: 240px; padding: 18px; }
}
